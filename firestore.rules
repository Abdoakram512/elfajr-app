rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // 🔧 Helper Functions
    // ──────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isActiveMerchant() {
      return isAuthenticated()
        && getUserData().role == 'merchant'
        && getUserData().isActive == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────
    // 👥 users Collection
    // ──────────────────────────────────────────────
    match /users/{userId} {
      // Allow read so users can perform email/role lookup during sign-in
      allow read: if true;

      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'isActive', 'isApproved']));
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // 💳 aid_cards Collection
    // ──────────────────────────────────────────────
    match /aid_cards/{cardId} {
      allow read: if isAdmin()
                  || isActiveMerchant()
                  || (isAuthenticated()
                      && resource.data.beneficiaryId == request.auth.uid);

      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isActiveMerchant()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['totalBalance', 'foodBasketsQuota', 'status']));
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // 🧾 redemptions Collection
    // ──────────────────────────────────────────────
    match /redemptions/{transactionId} {
      allow read: if isAdmin()
                  || (isActiveMerchant()
                      && resource.data.merchantId == request.auth.uid)
                  || (isAuthenticated()
                      && resource.data.beneficiaryId == request.auth.uid);

      allow create: if isActiveMerchant()
                    && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // 📊 stats Collection
    // ──────────────────────────────────────────────
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isActiveMerchant();
    }

    // ──────────────────────────────────────────────
    // 📄 content Collection
    // ──────────────────────────────────────────────
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // 📋 audit_log Collection
    // ──────────────────────────────────────────────
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────
    // 🚫 Deny All Other Collections
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
